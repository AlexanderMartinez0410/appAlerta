# ==========================================
# Plantilla de Variables de Entorno (.env.example)
# Copia este archivo a .env.dev o .env.prod según corresponda
# ==========================================

# Base de Datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
POSTGRES_PORT=5433

# Backend NestJS
BACKEND_PORT=3000
DB_HOST=postgres
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app_db?schema=public

# Frontend Expo / Web
FRONTEND_PORT=8081
EXPO_PUBLIC_API_URL=http://localhost:3000
